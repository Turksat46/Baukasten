msgstr "Messages"

#: templates/designer/script.html:60
msgid "Testlauf im Browser"
msgstr "Test run in the browser"

#: templates/designer/script.html:67
msgid "Kurzreferenz"
msgstr "Quick reference"

#: templates/designer/script.html:69
msgid ""
"Läuft im Browser der Person, die die Seite öffnet, mit ihren Rechten. Mit "
"await auf Ergebnisse warten."
msgstr ""
"Runs in the browser of the person who opens the page, with their rights. Use"
" await to wait for results."

#: templates/designer/script.html:90
msgid ""
"Läuft auf dem Server, abgeschottet, mit Zugriff auf alle Tabellen dieser "
"App."
msgstr "Runs on the server, isolated, with access to all tables of this app."

#: templates/designer/script.html:116
msgid "Mehr im Handbuch, Abschnitt „Skripte“."
msgstr "More in the manual, section “Scripts”."

#: templates/designer/script.html:121
