    },
    {
     "label": "Soll (Stück)",
     "key": "soll",
     "type": "number"
    },
    {
     "label": "Ist (Stück)",
     "key": "ist",
     "type": "number"
    },
    {
     "label": "Ausschuss (Stück)",
     "key": "ausschuss",
     "type": "number"
    },
    {
     "label": "Personal anwesend",
     "key": "personal",
     "type": "number"
    },
    {
     "label": "Erfüllung (%)",
     "key": "erfuellung",
