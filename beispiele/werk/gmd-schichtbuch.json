   ]
  }
 ],
 "scripts": [
  {
   "name": "Ampel letzte Schicht",
   "language": "python",
   "trigger": "page",
   "code": "rows = app.table(\"schichtbuch\").all()\nif rows:\n    letzte = max(rows, key=lambda r: (r[\"datum\"] or \"\", [\"Früh\", \"Spät\", \"Nacht\"].index(r[\"schicht\"]) if r[\"schicht\"] in [\"Früh\", \"Spät\", \"Nacht\"] else 0))\n    gleiche = [r for r in rows if r[\"datum\"] == letzte[\"datum\"] and r[\"schicht\"] == letzte[\"schicht\"]]\n    soll = sum(r[\"soll\"] or 0 for r in gleiche); ist = sum(r[\"ist\"] or 0 for r in gleiche)\n    quote = round(100 * ist / soll, 1) if soll else 0\n    ton = \"success\" if quote >= 95 else (\"warning\" if quote >= 85 else \"danger\")\n    ui.set(\"ampel\", tone=ton, title=f\"Erfüllung {letzte['schicht']}schicht {letzte['datum']}: {quote} %\",\n           text=f\"{ist} von {soll} Stück über {len(gleiche)} Linien.\")\n",
   "page": "uebergabe"
  }
 ],
