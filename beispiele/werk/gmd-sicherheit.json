{
 "slug": "gmd-sicherheit",
 "name": "Arbeitssicherheit & Sicherheitskreuz",
 "icon": "🦺",
 "description": "Beinahe-Unfälle anonym melden, Sicherheitskreuz, Schwerpunkte nach Bereich",
 "rolle": "Arbeitssicherheit / alle",
 "komplexitaet": "mittel",
 "entities": [
  {
   "name": "Meldungen",
   "slug": "meldungen",
   "fields": [
    {
     "label": "Datum",
     "key": "datum",
     "type": "date",
     "required": true
    },
    {
     "label": "Bereich",
     "key": "bereich",
     "type": "choice",
     "choices": [
      "Halle 1 Zerspanung",
      "Halle 2 Montage",
      "Halle 3 Prüffeld",
      "Logistik Wareneingang",
      "Werkstatt IH",
      "Härterei"
     ],
     "required": true
    },
    {
     "label": "Art",
     "key": "art",
     "type": "choice",
     "choices": [
      "Unsichere Situation",
      "Beinahe-Unfall",
      "Erste-Hilfe-Fall",
      "Unfall ohne Ausfall",
      "Unfall mit Ausfall"
     ],
     "required": true
    },
    {
     "label": "Was ist passiert?",
     "key": "beschreibung",
     "type": "longtext"
    },
    {
     "label": "Sofortmaßnahme",
     "key": "massnahme",
     "type": "text"
    },
    {
     "label": "Status",
     "key": "status",
     "type": "choice",
     "choices": [
      "Neu",
      "In Bearbeitung",
      "Erledigt"
     ]
    }
   ]
  }
 ],
 "pages": [
  {
   "title": "Melden",
   "slug": "melden",
   "layout": [
    {
     "type": "heading",
     "width": 12,
     "props": {
      "text": "Gefahr gesehen? Melden!",
      "subtitle": "Anonym – auch ohne Anmeldung über den QR-Code am Infoboard",
      "level": "1"
     }
    },
    {
     "type": "form",
     "width": 12,
     "props": {
      "entity": "meldungen",
      "submit_label": "Meldung absenden"
     }
    }
   ],
   "public": true
  },
  {
   "title": "Sicherheitskreuz",
   "slug": "kreuz",
   "layout": [
    {
     "type": "stat",
     "width": 4,
     "props": {
      "label": "Tage ohne Unfall mit Ausfall",
      "entity": "meldungen",
      "aggregate": "days_since",
      "field": "datum",
      "where": "Art = Unfall mit Ausfall",
      "direction": "lower_worse",
      "warn_at": "30",
      "alarm_at": "7"
     }
    },
    {
     "type": "stat",
     "width": 4,
     "props": {
      "label": "Meldungen diesen Monat",
      "entity": "meldungen",
      "where": "Datum >= monatsanfang"
     }
    },
    {
     "type": "progress",
     "width": 4,
     "props": {
      "label": "Meldungen (Ziel 40 im Quartal)",
      "entity": "meldungen",
      "target": 40,
      "where": "Datum >= quartalsanfang"
     }
    },
    {
     "type": "output",
     "width": 12,
     "props": {
      "label": "Sicherheitskreuz (aktueller Monat)"
     },
     "name": "kreuz"
    },
    {
     "type": "calendar",
     "width": 12,
     "props": {
      "title": "Meldungen im Kalender",
      "entity": "meldungen",
      "date_field": "datum",
      "label_field": "art",
      "color_field": "art",
      "create_links": false
     }
    }
   ]
  },
  {
   "title": "Auswertung",
   "slug": "auswertung",
   "layout": [
    {
     "type": "filter",
     "width": 12,
     "props": {
      "entity": "meldungen",
      "field": "bereich",
      "field2": "art",
      "field3": "status"
     }
    },
    {
     "type": "heatmap",
     "width": 12,
     "props": {
      "title": "Bereich × Art",
      "entity": "meldungen",
      "mode": "crosstab",
      "row_field": "bereich",
      "col_field": "art"
     }
    },
    {
     "type": "donut",
     "width": 6,
     "props": {
      "label": "Nach Art",
      "entity": "meldungen",
      "field": "art"
     }
    },
    {
     "type": "chart",
     "width": 6,
     "props": {
      "label": "Nach Bereich",
      "entity": "meldungen",
      "field": "bereich"
     }
    },
    {
     "type": "kanban",
     "width": 12,
     "props": {
      "entity": "meldungen",
      "field": "status",
      "detail": "bereich"
     }
    }
   ]
  }
 ],
 "scripts": [
  {
   "name": "Sicherheitskreuz",
   "language": "python",
   "trigger": "page",
   "code": "import datetime\nheute = datetime.date.today()\nrows = app.table(\"meldungen\").all()\nrang = {\"Unfall mit Ausfall\": \"🟥\", \"Unfall ohne Ausfall\": \"🟧\", \"Erste-Hilfe-Fall\": \"🟨\", \"Beinahe-Unfall\": \"🟦\", \"Unsichere Situation\": \"🟦\"}\nwoche = []\nzeilen = []\nfor tag in range(1, heute.day + 1):\n    d = heute.replace(day=tag).isoformat()\n    an = [r[\"art\"] for r in rows if r[\"datum\"] == d]\n    farbe = \"🟩\"\n    for art in [\"Unfall mit Ausfall\", \"Unfall ohne Ausfall\", \"Erste-Hilfe-Fall\"]:\n        if art in an:\n            farbe = rang[art]\n            break\n    woche.append(f\"{tag:02d} {farbe}\")\n    if len(woche) == 7:\n        zeilen.append({\"Tage\": \"  \".join(woche)}); woche = []\nif woche:\n    zeilen.append({\"Tage\": \"  \".join(woche)})\nui.set(\"kreuz\", rows=zeilen)\n",
   "page": "kreuz"
  }
 ],
