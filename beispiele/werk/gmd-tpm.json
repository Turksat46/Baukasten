     }
    }
   ]
  }
 ],
 "scripts": [
  {
   "name": "Fälligkeiten",
   "language": "python",
   "trigger": "page",
   "code": "import datetime\nheute = datetime.date.today()\nanlagen = {a[\"id\"]: a for a in app.table(\"anlagen\").all()}\nrows = app.table(\"wartungen\").all()\ndef tage(r):\n    return (datetime.date.fromisoformat(r[\"naechste\"]) - heute).days if r[\"naechste\"] else 9999\nueber = [r for r in rows if tage(r) < 0]\nn = len([r for r in ueber if anlagen.get(int(r[\"anlage\"] or 0), {}).get(\"krit\") == \"A\"])\nui.set(\"k_a\", value=n, tone=\"danger\" if n else \"success\")\n",
   "page": "faellig"
  }
 ],
