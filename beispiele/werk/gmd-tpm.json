  {
   "name": "Anlagen",
   "slug": "anlagen",
   "fields": [
    {
     "label": "Anlage",
     "key": "name",
     "type": "text",
     "required": true
    },
    {
     "label": "Linie",
     "key": "linie",
     "type": "choice",
     "choices": [
      "ZS-1 Zahnstange",
      "LG-2 Lenkgetriebe",
      "EPS-3 Servoeinheit",
      "PR-4 Endprüfung",
      "HT-5 Härterei",
      "VM-6 Ventilmontage",
      "Infrastruktur"
     ]
    },
    {
     "label": "Kritikalität",
     "key": "krit",
     "type": "choice",
     "choices": [
      "A",
      "B",
      "C"
     ]
    },
    {
     "label": "Baujahr",
     "key": "baujahr",
     "type": "number"
    }
   ]
  },
  {
   "name": "Wartungen",
   "slug": "wartungen",
   "fields": [
    {
     "label": "Anlage",
     "key": "anlage",
     "type": "reference",
     "reference": "anlagen",
     "required": true
    },
    {
     "label": "Aufgabe",
     "key": "aufgabe",
     "type": "text",
     "required": true
    },
    {
     "label": "Intervall (Tage)",
     "key": "intervall",
     "type": "number"
    },
    {
     "label": "Zuletzt",
     "key": "letzte",
     "type": "date"
    },
    {
     "label": "Nächste Fälligkeit",
     "key": "naechste",
     "type": "date",
     "formula": "letzte + intervall",
     "show_in_form": false
    },
    {
     "label": "Art",
     "key": "art",
     "type": "choice",
     "choices": [
      "Autonome IH (Werker)",
      "Geplante IH"
     ]
    },
    {
     "label": "Verantwortlich",
     "key": "verantwortlich",
     "type": "text"
    }
   ]
  }
 ],
