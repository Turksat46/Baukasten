 "scripts": [
  {
   "name": "5S-Profil",
   "language": "python",
   "trigger": "page",
   "code": "rows = app.table(\"audits\").all()\nnamen = [\"Sortieren\", \"Systematisieren\", \"Säubern\", \"Standardisieren\", \"Selbstdisziplin\"]\nmittel = []\nfor i, n in enumerate(namen, start=1):\n    werte = [r[f\"s{i}\"] for r in rows if r[f\"s{i}\"] is not None]\n    mittel.append((n, round(sum(werte) / len(werte), 2) if werte else 0))\nui.set(\"netz\", rows=[{\"S\": n, \"Ø\": m, \"Balken\": \"█\" * int(round(m * 4))} for n, m in mittel])\nschwach = min(mittel, key=lambda x: x[1]) if mittel else (\"–\", 0)\nui.set(\"schwaechstes\", value=schwach[0], unit=f\"Ø {schwach[1]}\")\n",
   "page": "auswertung"
  }
 ],
