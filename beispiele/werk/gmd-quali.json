{
 "slug": "gmd-quali",
 "name": "Qualifikationsmatrix",
 "icon": "🎓",
 "description": "Wer kann welche Station? ILUO-Stufen, ablaufende Qualifikationen, Springer-Planung",
 "rolle": "Meister / Personal",
 "komplexitaet": "mittel",
 "entities": [
  {
   "name": "Mitarbeitende",
   "slug": "mitarbeitende",
   "fields": [
    {
     "label": "Name",
     "key": "name",
     "type": "text",
     "required": true
    },
    {
     "label": "Schicht",
     "key": "schicht",
     "type": "choice",
     "choices": [
      "Früh",
      "Spät",
      "Nacht"
     ]
    },
    {
     "label": "Kostenstelle",
     "key": "kst",
     "type": "choice",
     "choices": [
      "4711 Montage",
      "4712 Zerspanung",
      "4713 Prüffeld"
     ]
    }
   ]
  },
  {
   "name": "Stationen",
   "slug": "stationen",
   "fields": [
    {
     "label": "Station",
     "key": "name",
     "type": "text",
     "required": true
    },
    {
     "label": "Linie",
     "key": "linie",
     "type": "choice",
     "choices": [
      "ZS-1 Zahnstange",
      "LG-2 Lenkgetriebe",
      "EPS-3 Servoeinheit",
      "PR-4 Endprüfung",
      "HT-5 Härterei",
      "VM-6 Ventilmontage"
     ]
    }
   ]
  },
  {
   "name": "Qualifikationen",
   "slug": "qualifikationen",
   "fields": [
    {
     "label": "Mitarbeiter/in",
     "key": "mitarbeiter",
     "type": "reference",
     "reference": "mitarbeitende",
     "required": true
    },
    {
     "label": "Station",
     "key": "station",
     "type": "reference",
     "reference": "stationen",
     "required": true
    },
    {
     "label": "Stufe (1=I angelernt … 4=O Trainer)",
     "key": "stufe",
     "type": "number"
    },
    {
     "label": "Gültig bis",
     "key": "gueltig",
     "type": "date"
    }
   ]
  }
 ],
 "pages": [
  {
   "title": "Matrix",
   "slug": "matrix",
   "layout": [
    {
     "type": "heading",
     "width": 12,
     "props": {
      "text": "Qualifikationsmatrix",
      "subtitle": "1 = I (in Ausbildung) · 2 = L (unter Aufsicht) · 3 = U (selbstständig) · 4 = O (Trainer)",
      "level": "1"
     }
    },
    {
     "type": "filter",
     "width": 12,
     "props": {
      "entity": "qualifikationen",
      "field": "station"
     }
    },
    {
     "type": "heatmap",
     "width": 12,
     "props": {
      "title": "Stufe je Person und Station",
      "entity": "qualifikationen",
      "mode": "crosstab",
      "row_field": "mitarbeiter",
      "col_field": "station",
      "value_field": "stufe",
      "agg": "avg"
     }
    },
    {
     "type": "output",
     "width": 6,
     "props": {
      "label": "Stationen mit weniger als 3 selbstständigen Personen"
     },
     "name": "engpass"
    },
    {
     "type": "table",
     "width": 6,
     "props": {
      "title": "Läuft in den nächsten 60 Tagen ab",
      "entity": "qualifikationen",
      "where": "Gültig bis <= heute+60"
     }
    }
   ]
  },
  {
   "title": "Pflegen",
   "slug": "pflegen",
   "layout": [
    {
     "type": "form",
     "width": 6,
     "props": {
      "entity": "qualifikationen",
      "submit_label": "Qualifikation speichern"
     }
    },
    {
     "type": "table",
     "width": 6,
     "props": {
      "entity": "mitarbeitende"
     }
    },
    {
     "type": "table",
     "width": 12,
     "props": {
      "entity": "qualifikationen",
      "searchable": true
     }
    }
   ]
  }
 ],
 "scripts": [
  {
   "name": "Engpässe",
   "language": "python",
   "trigger": "page",
   "code": "import datetime\nheute = datetime.date.today()\nleute = {p[\"id\"]: p[\"name\"] for p in app.table(\"mitarbeitende\").all()}\nstationen = {s[\"id\"]: s[\"name\"] for s in app.table(\"stationen\").all()}\nq = app.table(\"qualifikationen\").all()\nzeilen = []\nfor sid, name in stationen.items():\n    n = len([x for x in q if int(x[\"station\"] or 0) == sid and (x[\"stufe\"] or 0) >= 3])\n    if n < 3:\n        zeilen.append({\"Station\": name, \"selbstständig\": n, \"fehlen\": 3 - n})\nui.set(\"engpass\", rows=zeilen)\n",
   "page": "matrix"
  }
 ],
