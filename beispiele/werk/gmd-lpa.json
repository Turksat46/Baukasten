{
 "slug": "gmd-lpa",
 "name": "Layered Process Audit",
 "icon": "🧅",
 "description": "Prozessaudits auf drei Ebenen, Erfüllungsquote, Abweichungen mit Maßnahmen",
 "rolle": "Meister · Abteilungsleiter · Werksleiter",
 "komplexitaet": "mittel",
 "entities": [
  {
   "name": "Audits",
   "slug": "audits",
   "fields": [
    {
     "label": "Datum",
     "key": "datum",
     "type": "date",
     "required": true
    },
    {
     "label": "Ebene",
     "key": "ebene",
     "type": "choice",
     "choices": [
      "Meister (täglich)",
      "Abteilungsleiter (wöchentlich)",
      "Werksleiter (monatlich)"
     ],
     "required": true
    },
    {
     "label": "Linie",
     "key": "linie",
     "type": "choice",
     "choices": [
      "ZS-1 Zahnstange",
      "LG-2 Lenkgetriebe",
      "EPS-3 Servoeinheit",
      "PR-4 Endprüfung",
      "HT-5 Härterei",
      "VM-6 Ventilmontage"
     ]
    },
    {
     "label": "Auditor/in",
     "key": "auditor",
     "type": "text"
    },
    {
     "label": "Fragen i. O.",
     "key": "ok",
     "type": "number"
    },
    {
     "label": "Fragen n. i. O.",
     "key": "nok",
     "type": "number"
    },
    {
     "label": "Erfüllung (%)",
     "key": "quote",
     "type": "decimal",
     "formula": "round(ok / (ok + nok) * 100, 1)",
     "show_in_form": false
    }
   ]
  },
  {
   "name": "Abweichungen",
   "slug": "abweichungen",
   "fields": [
    {
     "label": "Audit",
     "key": "audit",
     "type": "reference",
     "reference": "audits"
    },
    {
     "label": "Abweichung",
     "key": "text",
     "type": "text",
     "required": true
    },
    {
     "label": "Maßnahme",
     "key": "massnahme",
     "type": "text"
    },
    {
     "label": "Erledigt",
     "key": "erledigt",
     "type": "bool"
    }
   ]
  }
 ],
 "pages": [
  {
   "title": "Durchführen",
   "slug": "durchfuehren",
   "layout": [
    {
     "type": "heading",
     "width": 12,
     "props": {
      "text": "LPA durchführen",
      "subtitle": "10 Fragen · Abweichungen sofort mit Maßnahme anlegen",
      "level": "1"
     }
    },
    {
     "type": "form",
     "width": 6,
     "props": {
      "entity": "audits",
      "submit_label": "Audit speichern"
     }
    },
    {
     "type": "form",
     "width": 6,
     "props": {
      "entity": "abweichungen",
      "submit_label": "Abweichung anlegen"
     }
    }
   ]
  },
  {
   "title": "Auswertung",
   "slug": "auswertung",
   "layout": [
    {
     "type": "filter",
     "width": 12,
     "props": {
      "entity": "audits",
      "field": "ebene",
      "field2": "linie",
      "field3": "datum"
     }
    },
    {
     "type": "stat",
     "width": 4,
     "props": {
      "label": "Ø Erfüllung",
      "entity": "audits",
      "aggregate": "avg",
      "field": "quote",
      "unit": "%"
     }
    },
    {
     "type": "stat",
     "width": 4,
     "props": {
      "label": "Audits",
      "entity": "audits"
     }
    },
    {
     "type": "output",
     "width": 4,
     "props": {
      "label": "Soll/Ist Audits diesen Monat"
     },
     "name": "plan"
    },
    {
     "type": "pivot",
     "width": 12,
     "props": {
      "title": "Erfüllung Linie × Ebene",
      "entity": "audits",
      "row_field": "linie",
      "col_field": "ebene",
      "agg": "avg",
      "value_field": "quote"
     }
    },
    {
     "type": "line",
     "width": 12,
     "props": {
      "label": "Ø Erfüllung je Woche",
      "entity": "audits",
      "date_field": "datum",
      "aggregate": "avg",
      "field": "quote",
      "period": "week",
      "count": 9,
      "threshold": "90"
     }
    },
    {
     "type": "checklist",
     "width": 12,
     "props": {
      "title": "Abweichungen",
      "entity": "abweichungen",
      "field": "erledigt",
      "label_field": "text",
      "detail": "massnahme"
     }
    }
   ]
  }
 ],
 "scripts": [
  {
   "name": "Plan-Erfüllung",
   "language": "python",
   "trigger": "page",
   "code": "import datetime\nheute = datetime.date.today()\nmonat = heute.isoformat()[:7]\nrows = [r for r in app.table(\"audits\").all() if (r[\"datum\"] or \"\").startswith(monat)]\nsoll = {\"Meister (täglich)\": 22 * 6, \"Abteilungsleiter (wöchentlich)\": 4 * 6, \"Werksleiter (monatlich)\": 1}\nanteil = heute.day / 30\nui.set(\"plan\", rows=[{\"Ebene\": e, \"Ist\": len([r for r in rows if r[\"ebene\"] == e]), \"Soll bis heute\": round(s * anteil)}\n                     for e, s in soll.items()])\n",
   "page": "auswertung"
  }
 ],
