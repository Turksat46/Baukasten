{
 "slug": "gmd-nachschub",
 "name": "Materialnachschub (Routenzug)",
 "icon": "🚚",
 "description": "Nachschub an die Linie anfordern, Routenzug-Aufträge abarbeiten, Unterdeckungen erkennen",
 "rolle": "Logistik",
 "komplexitaet": "mittel",
 "entities": [
  {
   "name": "Material",
   "slug": "material",
   "fields": [
    {
     "label": "Sachnummer",
     "key": "sachnr",
     "type": "text",
     "required": true
    },
    {
     "label": "Bezeichnung",
     "key": "bezeichnung",
     "type": "text"
    },
    {
     "label": "Lagerort",
     "key": "lagerort",
     "type": "text"
    },
    {
     "label": "Bestand",
     "key": "bestand",
     "type": "number"
    },
    {
     "label": "Mindestbestand",
     "key": "mindest",
     "type": "number"
    },
    {
     "label": "Reichweite über Minimum",
     "key": "puffer",
     "type": "number",
     "formula": "bestand - mindest",
     "show_in_form": false
    }
   ]
  },
  {
   "name": "Anforderungen",
   "slug": "anforderungen",
   "fields": [
    {
     "label": "Material",
     "key": "material",
     "type": "reference",
     "reference": "material",
     "required": true
    },
    {
     "label": "Linie",
     "key": "linie",
     "type": "choice",
     "choices": [
      "ZS-1 Zahnstange",
      "LG-2 Lenkgetriebe",
      "EPS-3 Servoeinheit",
      "PR-4 Endprüfung",
      "HT-5 Härterei",
      "VM-6 Ventilmontage"
     ],
     "required": true
    },
    {
     "label": "Behälter",
     "key": "behaelter",
     "type": "number"
    },
    {
     "label": "Status",
     "key": "status",
     "type": "choice",
     "choices": [
      "Angefordert",
      "Kommissioniert",
      "Auf Routenzug",
      "Geliefert"
     ]
    },
    {
     "label": "Angefordert am",
     "key": "datum",
     "type": "date"
    },
    {
     "label": "Dringend",
     "key": "dringend",
     "type": "bool"
    }
   ]
  }
 ],
 "pages": [
  {
   "title": "Anfordern",
   "slug": "anfordern",
   "layout": [
    {
     "type": "heading",
     "width": 12,
     "props": {
      "text": "Nachschub anfordern",
      "subtitle": "Kanban-Karte scannen oder Material auswählen",
      "level": "1"
     }
    },
    {
     "type": "form",
     "width": 6,
     "props": {
      "entity": "anforderungen",
      "submit_label": "Anfordern"
     }
    },
    {
     "type": "stat",
     "width": 6,
     "props": {
      "label": "Material unter Mindestbestand",
      "entity": "material",
      "where": "Bestand < Mindestbestand",
      "warn_at": "1",
      "alarm_at": "3"
     }
    }
   ]
  },
  {
   "title": "Routenzug",
   "slug": "routenzug",
   "layout": [
    {
     "type": "filter",
     "width": 12,
     "props": {
      "entity": "anforderungen",
      "field": "linie",
      "field2": "dringend"
     }
    },
    {
     "type": "kanban",
     "width": 12,
     "props": {
      "title": "Aufträge",
      "entity": "anforderungen",
      "field": "status",
      "detail": "material",
      "limit": 10
     }
    },
    {
     "type": "donut",
     "width": 6,
     "props": {
      "label": "Anforderungen je Linie",
      "entity": "anforderungen",
      "field": "linie"
     }
    },
    {
     "type": "stat",
     "width": 6,
     "props": {
      "label": "Nicht geliefert",
      "entity": "anforderungen",
      "where": "Status != Geliefert"
     }
    }
   ]
  },
  {
   "title": "Bestand",
   "slug": "bestand",
   "layout": [
    {
     "type": "table",
     "width": 12,
     "props": {
      "title": "Material unter Mindestbestand",
      "entity": "material",
      "where": "Bestand < Mindestbestand"
     }
    },
    {
     "type": "table",
     "width": 12,
     "props": {
      "entity": "material",
      "searchable": true
     }
    },
    {
     "type": "csv_import",
     "width": 12,
     "props": {
      "entity": "material",
      "label": "Bestand aus SAP-Export (CSV) laden"
     }
    }
   ]
  }
 ],
