     "type": "stat",
     "width": 4,
     "props": {
      "label": "D · Liefertreue heute (%, Ziel ≥ 97)",
      "entity": "kennzahlen",
      "aggregate": "avg",
      "field": "d",
      "where": "Datum = heute",
      "direction": "lower_worse",
      "warn_at": "97",
      "alarm_at": "95"
