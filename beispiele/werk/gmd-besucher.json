{
 "slug": "gmd-besucher",
 "name": "Fremdfirmen & Besucher",
 "icon": "🪪",
 "description": "Voranmeldung, Sicherheitsunterweisung, wer ist gerade im Werk (Evakuierungsliste)",
 "rolle": "Pforte / Ansprechpartner",
 "komplexitaet": "mittel",
 "entities": [
  {
   "name": "Besuche",
   "slug": "besuche",
   "fields": [
    {
     "label": "Name",
     "key": "name",
     "type": "text",
     "required": true
    },
    {
     "label": "Firma",
     "key": "firma",
     "type": "text",
     "required": true
    },
    {
     "label": "Ansprechpartner/in",
     "key": "ansprechpartner",
     "type": "text"
    },
    {
     "label": "Datum",
     "key": "datum",
     "type": "date",
     "required": true
    },
    {
     "label": "Bereich",
     "key": "bereich",
     "type": "choice",
     "choices": [
      "Halle 1 Zerspanung",
      "Halle 2 Montage",
      "Halle 3 Prüffeld",
      "Logistik Wareneingang",
      "Werkstatt IH",
      "Härterei"
     ]
    },
    {
     "label": "Sicherheitsunterweisung erhalten",
     "key": "unterweisung",
     "type": "bool"
    },
    {
     "label": "Status",
     "key": "status",
     "type": "choice",
     "choices": [
      "Angemeldet",
      "Vor Ort",
      "Abgemeldet"
     ]
    },
    {
     "label": "Besucherausweis",
     "key": "ausweis",
     "type": "text"
    }
   ]
  }
 ],
 "pages": [
  {
   "title": "Voranmeldung",
   "slug": "anmeldung",
   "layout": [
    {
     "type": "heading",
     "width": 12,
     "props": {
      "text": "Besuch voranmelden",
      "level": "1"
     }
    },
    {
     "type": "form",
     "width": 12,
     "props": {
      "entity": "besuche",
      "submit_label": "Anmelden"
     }
    }
   ]
  },
  {
   "title": "Pforte",
   "slug": "pforte",
   "layout": [
    {
     "type": "stat",
     "width": 4,
     "props": {
      "label": "Jetzt im Werk",
      "entity": "besuche",
      "where": "Status = Vor Ort"
     }
    },
    {
     "type": "stat",
     "width": 4,
     "props": {
      "label": "Heute angemeldet",
      "entity": "besuche",
      "where": "Datum = heute"
     }
    },
    {
     "type": "stat",
     "width": 4,
     "props": {
      "label": "Vor Ort ohne Unterweisung",
      "entity": "besuche",
      "where": "Status = Vor Ort\nSicherheitsunterweisung erhalten = nein",
      "alarm_at": "1"
     }
    },
    {
     "type": "search",
     "width": 12,
     "props": {
      "entity": "besuche",
      "field": "name"
     }
    },
    {
     "type": "table",
     "width": 12,
     "props": {
      "title": "Evakuierungsliste (Status „Vor Ort“)",
      "entity": "besuche",
      "where": "Status = Vor Ort",
      "page_size": 100
     }
    },
    {
     "type": "kanban",
     "width": 12,
     "props": {
      "entity": "besuche",
      "field": "status",
      "detail": "firma"
     }
    }
   ]
  },
  {
   "title": "Kalender",
   "slug": "kalender",
   "layout": [
    {
     "type": "calendar",
     "width": 12,
     "props": {
      "entity": "besuche",
      "date_field": "datum",
      "label_field": "firma",
      "color_field": "status"
     }
    }
   ]
  }
 ],
