{
 "slug": "gmd-ideen",
 "name": "Ideenmanagement",
 "icon": "💡",
 "description": "Verbesserungsvorschläge einreichen, Status verfolgen, umgesetzte Einsparungen",
 "rolle": "Alle Mitarbeitenden",
 "komplexitaet": "einfach",
 "entities": [
  {
   "name": "Ideen",
   "slug": "ideen",
   "fields": [
    {
     "label": "Idee",
     "key": "titel",
     "type": "text",
     "required": true
    },
    {
     "label": "Bereich",
     "key": "bereich",
     "type": "choice",
     "choices": [
      "Halle 1 Zerspanung",
      "Halle 2 Montage",
      "Halle 3 Prüffeld",
      "Logistik Wareneingang",
      "Werkstatt IH",
      "Härterei"
     ]
    },
    {
     "label": "Eingereicht von",
     "key": "einreicher",
     "type": "text"
    },
    {
     "label": "Kategorie",
     "key": "kategorie",
     "type": "choice",
     "choices": [
      "Arbeitssicherheit",
      "Qualität",
      "Kosten",
      "Ergonomie",
      "Umwelt"
     ]
    },
    {
     "label": "Einsparung pro Jahr (€)",
     "key": "ersparnis",
     "type": "number"
    },
    {
     "label": "Status",
     "key": "status",
     "type": "choice",
     "choices": [
      "Eingereicht",
      "In Prüfung",
      "Umgesetzt",
      "Abgelehnt"
     ]
    },
    {
     "label": "Datum",
     "key": "datum",
     "type": "date"
    },
    {
     "label": "Beschreibung",
     "key": "beschreibung",
     "type": "longtext",
     "show_in_list": false
    }
   ]
  }
 ],
 "pages": [
  {
   "title": "Einreichen",
   "slug": "einreichen",
   "layout": [
    {
     "type": "heading",
     "width": 12,
     "props": {
      "text": "Deine Idee zählt",
      "level": "1"
     }
    },
    {
     "type": "form",
     "width": 8,
     "props": {
      "entity": "ideen",
      "submit_label": "Idee einreichen"
     }
    },
    {
     "type": "stat",
     "width": 4,
     "props": {
      "label": "Umgesetzte Einsparung",
      "entity": "ideen",
      "aggregate": "sum",
      "field": "ersparnis",
      "unit": "€/Jahr",
      "where": "Status = Umgesetzt"
     }
    }
   ]
  },
  {
   "title": "Board",
   "slug": "board",
   "layout": [
    {
     "type": "filter",
     "width": 12,
     "props": {
      "entity": "ideen",
      "field": "bereich",
      "field2": "kategorie"
     }
    },
    {
     "type": "kanban",
     "width": 12,
     "props": {
      "entity": "ideen",
      "field": "status",
      "detail": "einreicher"
     }
    },
    {
     "type": "donut",
     "width": 6,
     "props": {
      "label": "Nach Kategorie",
      "entity": "ideen",
      "field": "kategorie"
     }
    },
    {
     "type": "chart",
     "width": 6,
     "props": {
      "label": "Nach Bereich",
      "entity": "ideen",
      "field": "bereich"
     }
    }
   ]
  }
 ],
