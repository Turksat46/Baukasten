 "scripts": [
  {
   "name": "Projektstatus",
   "language": "python",
   "trigger": "page",
   "code": "import datetime\nheute = datetime.date.today()\npakete = app.table(\"pakete\").all()\nblock = [p for p in pakete if p[\"status\"] == \"Blockiert\"]\nverzug = [p for p in pakete if p[\"ende\"] and p[\"status\"] != \"Erledigt\" and datetime.date.fromisoformat(p[\"ende\"]) < heute]\nhoch = [r for r in app.table(\"risiken\").all() if (r[\"rz\"] or 0) >= 12 and r[\"status\"] == \"Offen\"]\nton = \"danger\" if block or len(verzug) > 1 else (\"warning\" if verzug or hoch else \"success\")\nui.set(\"ampel\", tone=ton, text=f\"{len(verzug)} Paket(e) im Verzug, {len(block)} blockiert, {len(hoch)} hohe Risiken offen.\")\n",
   "page": "status"
  }
 ],
