{
 "slug": "gmd-andon",
 "name": "Andon & Störungsmeldung",
 "icon": "🚨",
 "description": "Störungen an der Linie melden, Andon-Tafel mit Linienstatus, Stillstands-Pareto",
 "rolle": "Werker / Instandhaltung",
 "komplexitaet": "mittel",
 "entities": [
  {
   "name": "Störungen",
   "slug": "stoerungen",
   "fields": [
    {
     "label": "Störung",
     "key": "titel",
     "type": "text",
     "required": true
    },
    {
     "label": "Linie",
     "key": "linie",
     "type": "choice",
     "choices": [
      "ZS-1 Zahnstange",
      "LG-2 Lenkgetriebe",
      "EPS-3 Servoeinheit",
      "PR-4 Endprüfung",
      "HT-5 Härterei",
      "VM-6 Ventilmontage"
     ],
     "required": true
    },
    {
     "label": "Kategorie",
     "key": "kategorie",
     "type": "choice",
     "choices": [
      "Mechanik",
      "Elektrik",
      "Hydraulik",
      "Steuerung/Software",
      "Material fehlt",
      "Qualität"
     ]
    },
    {
     "label": "Priorität",
     "key": "prioritaet",
     "type": "choice",
     "choices": [
      "Hoch",
      "Mittel",
      "Niedrig"
     ]
    },
    {
     "label": "Status",
     "key": "status",
     "type": "choice",
     "choices": [
      "Offen",
      "In Arbeit",
      "Wartet auf Teil",
      "Behoben"
     ]
    },
    {
     "label": "Gemeldet am",
     "key": "gemeldet",
     "type": "date"
    },
    {
     "label": "Stillstand (min)",
     "key": "dauer_min",
     "type": "number"
    },
    {
     "label": "Gemeldet von",
     "key": "gemeldet_von",
     "type": "text"
    },
    {
     "label": "Beschreibung",
     "key": "beschreibung",
     "type": "longtext",
     "show_in_list": false
    }
   ]
  }
 ],
 "pages": [
  {
   "title": "Andon-Tafel",
   "slug": "tafel",
   "layout": [
    {
     "type": "heading",
     "width": 12,
     "props": {
      "text": "Andon-Tafel",
      "subtitle": "Werk Gmünd · Halle 2",
      "level": "1"
     }
    },
    {
     "type": "stat",
     "width": 4,
     "props": {
      "label": "Offene Störungen",
      "entity": "stoerungen",
      "where": "Status != Behoben",
      "warn_at": "5",
      "alarm_at": "10"
