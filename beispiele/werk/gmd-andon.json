 "scripts": [
  {
   "name": "Andon berechnen",
   "language": "python",
   "trigger": "page",
   "code": "rows = app.table(\"stoerungen\").all()\noffen = [r for r in rows if r[\"status\"] != \"Behoben\"]\nlinien = [\"ZS-1 Zahnstange\", \"LG-2 Lenkgetriebe\", \"EPS-3 Servoeinheit\", \"PR-4 Endprüfung\", \"HT-5 Härterei\", \"VM-6 Ventilmontage\"]\nfor i, linie in enumerate(linien, start=1):\n    l_offen = [r for r in offen if r[\"linie\"] == linie]\n    hoch = [r for r in l_offen if r[\"prioritaet\"] == \"Hoch\"]\n    ton = \"danger\" if hoch else (\"warning\" if l_offen else \"success\")\n    ui.set(f\"linie{i}\", tone=ton, title=linie,\n           text=(\"Steht: \" + hoch[0][\"titel\"]) if hoch else (f\"{len(l_offen)} offene Meldung(en)\" if l_offen else \"Läuft\"))\n",
   "page": "tafel"
  }
 ],
