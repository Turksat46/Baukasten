{
 "slug": "gmd-smed",
 "name": "Rüstzeit-Analyse (SMED)",
 "icon": "⏱️",
 "description": "Rüstvorgänge erfassen, intern/extern trennen, Verzögerungen nach Ursache auswerten",
 "rolle": "Prozessingenieur",
 "komplexitaet": "mittel",
 "entities": [
  {
   "name": "Rüstvorgänge",
   "slug": "ruesten",
   "fields": [
    {
     "label": "Datum",
     "key": "datum",
     "type": "date",
     "required": true
    },
    {
     "label": "Linie",
     "key": "linie",
     "type": "choice",
     "choices": [
      "ZS-1 Zahnstange",
      "LG-2 Lenkgetriebe",
      "EPS-3 Servoeinheit"
     ]
    },
    {
     "label": "Von Typ",
     "key": "von",
     "type": "text"
    },
    {
     "label": "Nach Typ",
     "key": "nach",
     "type": "text"
    },
    {
     "label": "Intern (min)",
     "key": "intern",
     "type": "number"
    },
    {
     "label": "Extern (min)",
     "key": "extern",
     "type": "number"
    },
    {
     "label": "Verzögerung (min)",
     "key": "verzoegerung",
     "type": "number"
    },
    {
     "label": "Rüstzeit gesamt (min)",
     "key": "gesamt",
     "type": "number",
     "formula": "intern + verzoegerung",
     "show_in_form": false
    },
    {
     "label": "Ursache Verzögerung",
     "key": "ursache",
     "type": "choice",
     "choices": [
      "Werkzeug nicht vorbereitet",
      "Warten auf Erstmusterfreigabe",
      "Programm suchen",
      "Spannmittel fehlt",
      "Kran belegt",
      "Keine Verzögerung"
     ]
    }
   ]
  }
 ],
 "pages": [
  {
   "title": "Analyse",
   "slug": "analyse",
   "layout": [
    {
     "type": "heading",
     "width": 12,
     "props": {
      "text": "Rüstzeit-Analyse",
      "subtitle": "Ziel: Rüstzeit < 30 min (Single Minute Exchange of Die)",
      "level": "1"
     }
    },
    {
     "type": "filter",
     "width": 12,
     "props": {
      "entity": "ruesten",
      "field": "linie",
      "field2": "ursache",
      "field3": "datum"
     }
    },
    {
     "type": "stat",
     "width": 4,
     "props": {
      "label": "Ø Rüstzeit",
      "entity": "ruesten",
      "aggregate": "avg",
      "field": "gesamt",
      "unit": "min"
     }
    },
    {
     "type": "stat",
     "width": 4,
     "props": {
      "label": "Verlorene Minuten (Verzögerung)",
      "entity": "ruesten",
      "aggregate": "sum",
      "field": "verzoegerung",
      "unit": "min"
     }
    },
    {
     "type": "progress",
     "width": 4,
     "props": {
      "label": "Rüstvorgänge im Monat (Ziel 100)",
      "entity": "ruesten",
      "target": 100,
      "where": "Datum >= monatsanfang"
     }
    },
    {
     "type": "chart",
     "width": 6,
     "props": {
      "label": "Pareto: Verzögerung nach Ursache (Summe min)",
      "entity": "ruesten",
      "field": "ursache",
      "agg": "sum",
      "value_field": "verzoegerung",
      "pareto": true,
      "where": "Ursache != Keine Verzögerung"
     }
    },
    {
     "type": "scatter",
     "width": 6,
     "props": {
      "title": "Intern vs. Extern",
      "entity": "ruesten",
      "x_field": "intern",
      "y_field": "extern",
      "color_field": "linie",
      "trendline": true
     }
    },
    {
     "type": "line",
     "width": 12,
     "props": {
      "label": "Ø Rüstzeit je Woche",
      "entity": "ruesten",
      "date_field": "datum",
      "aggregate": "avg",
      "field": "gesamt",
      "period": "week",
      "count": 9,
      "threshold": "30"
     }
    },
    {
     "type": "pivot",
     "width": 12,
     "props": {
      "title": "Ø Rüstzeit Linie × Zieltyp",
      "entity": "ruesten",
      "row_field": "linie",
      "col_field": "nach",
      "agg": "avg",
      "value_field": "gesamt"
     }
    }
   ]
  },
  {
   "title": "Erfassen",
   "slug": "erfassen",
   "layout": [
    {
     "type": "form",
     "width": 12,
     "props": {
      "entity": "ruesten",
      "submit_label": "Rüstvorgang speichern"
     }
    },
    {
     "type": "table",
     "width": 12,
     "props": {
      "entity": "ruesten",
      "page_size": 15
     }
    }
   ]
  }
 ],
